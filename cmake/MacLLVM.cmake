if(CMAKE_HOST_APPLE AND NOT DEFINED CMAKE_CXX_COMPILER AND NOT DEFINED ENV{CXX}
   AND NOT PM_USE_APPLE_CLANG)
  set(_llvm "")
  foreach(_p /opt/homebrew/opt/llvm /usr/local/opt/llvm)
    if(EXISTS "${_p}/bin/clang++")
      set(_llvm "${_p}")
      break()
    endif()
  endforeach()
  if(_llvm)
    message(STATUS "Using Homebrew LLVM at ${_llvm} (set -DPM_USE_APPLE_CLANG=ON to opt out)")
    set(CMAKE_CXX_COMPILER "${_llvm}/bin/clang++" CACHE FILEPATH "" FORCE)
    set(CMAKE_C_COMPILER "${_llvm}/bin/clang" CACHE FILEPATH "" FORCE)
    # Link Homebrew's libc++ so headers and library match.
    set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${_llvm}/lib/c++ -Wl,-rpath,${_llvm}/lib/c++")
    set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")
    set(CMAKE_AR "${_llvm}/bin/llvm-ar" CACHE FILEPATH "" FORCE)
    set(CMAKE_RANLIB "${_llvm}/bin/llvm-ranlib" CACHE FILEPATH "" FORCE)
  endif()
endif()
